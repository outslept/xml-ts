    "mitata": "^1.0.34",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "xml": "^1.0.1",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devEngines": {
    "packageManager": {
